{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Server",
			"type": "shell",
			"command": "./gradlew",
			"args": ["server:bootRun", "-Dspring.devtools.restart.enabled=false"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"icon": { "id": "server" },
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				{
					"owner": "spring-boot",
					"pattern": [
						{
							"regexp": "^\\S+\\s+(ERROR)\\s+\\d+\\s+---\\s+\\[.*?\\]\\s+\\S+\\s*:\\s*(.*)$",
							"severity": 1,
							"message": 2
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".*Starting ShowcaseServerApplication.*",
						"endsPattern": ".*(Started ShowcaseServerApplication|Application run failed).*"
					}
				}
			]
		},
		{
			"label": "Start TSC",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "start:typescript"],
			"options": { "cwd": "${workspaceFolder}" },
			"icon": { "id": "symbol-module" },
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": ["$tsc-watch"]
		},
		{
			"label": "Start Showcase",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "start"],
			"options": { "cwd": "${workspaceFolder}/showcase" },
			"icon": { "id": "browser" },
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				{
					"owner": "rsbuild",
					"fileLocation": ["relative", "${workspaceFolder}/showcase"],
					"pattern": {
						"regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+):\\s+(.*)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"severity": 4,
						"code": 5,
						"message": 6
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^.*Rsbuild v\\d+.*starting.*$",
						"endsPattern": "^.*ready\\s+built in .*$"
					}
				}
			]
		},
		{
			"label": "Compile",
			"type": "shell",
			"command": "pnpm",
			"args": ["compile"],
			"options": { "cwd": "${workspaceFolder}" },
			"icon": { "id": "gear" },
			"group": { "kind": "build", "isDefault": true },
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": ["$tsc", "$eslint-stylish"]
		},
		{
			"label": "Clean",
			"type": "shell",
			"command": "pnpm",
			"args": ["clean"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"icon": {
				"id": "trash"
			},
			"problemMatcher": ["$tsc"],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false,
				"group": "build"
			}
		},
		{
			"label": "Start",
			"dependsOrder": "parallel",
			"dependsOn": ["Start Server", "Start TSC", "Start Showcase"],
			"icon": {
				"id": "rocket"
			},
			"problemMatcher": []
		},
		{
			"label": "Playwright Dev",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "testE2E", "--ui-host", "0.0.0.0"],
			"options": { "cwd": "${workspaceFolder}/e2e" },
			"icon": { "id": "beaker" },
			"group": { "kind": "test", "isDefault": true },
			"isBackground": true
		},
		{
			"label": "Seed - Reset",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "start:seed"],
			"options": { "cwd": "${workspaceFolder}/showcase" },
			"icon": { "id": "check" },
			"problemMatcher": []
		},
		{
			"label": "Upload Showcase Models",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "upload-models"],
			"options": { "cwd": "${workspaceFolder}/showcase" },
			"icon": { "id": "book" },
			"problemMatcher": []
		}
	]
}
