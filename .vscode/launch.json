{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "launch",
			"name": "Launch Chrome Debugging",
			"url": "http://localhost:17000/composable",
			"webRoot": "${workspaceFolder}/showcase",
			"preLaunchTask": "Start",
			"sourceMapPathOverrides": {
				"webpack://@com.mgmtp.a12.relationshipengine/relationshipengine-core/*": "${workspaceFolder}/core/*",
				"webpack://@com.mgmtp.a12.crud/crud-core/*": "${workspaceFolder}/crud/*"
			},
			"skipFiles": ["<node_internals>/**", "${workspaceFolder}/**/node_modules/**"],
			"trace": true,
			"userDataDir": "${userHome}/.vscode/chrome",
			"runtimeArgs": ["--new-window", "--disable-background-networking", "--profile-directory=debug-profile"]
		}
	]
}
