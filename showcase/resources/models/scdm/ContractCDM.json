								"id": "rule_f0943",
								"name": "GermanContract",
								"Rule": {
									"errorEntityRelPath": "../../contract/type",
									"errorCode": "Error rule_84ca9",
									"errorCondition": "GroupFilled(/contract) and\r\nGroupFilled(/PolicyHolder/PostAddress/address) and\r\nAllFieldsFilled(/contract/type, /PolicyHolder/PostAddress/address/country) and\r\n[/contract/type] == \"german\" and [/PolicyHolder/PostAddress/address/country] != \"Germany\"",
									"severity": "ERROR",
									"errorMessage": [
										{
											"locale": "en",
											"text": "The post address of the policy holder must be in germany in case of a \"german\" contract type."
										},
										{
											"locale": "de",
											"text": "Die Postanschrift des Policeninhabers muss in Deutschland liegen, wenn es sich um einen Deutschen Vertrag handelt."
										}
