									"errorCode": "Error rule_bb9ae",
									"errorCondition": "AtLeastOneFieldValueIncludedInValueList(\r\n/CoInsurer*/businessPartner/id IN /PolicyHolder/businessPartner/id \r\n)",
									"severity": "ERROR",
									"errorMessage": [
										{
											"locale": "en",
											"text": "The policy holder must not be part of the co-insurers."
										},
										{
