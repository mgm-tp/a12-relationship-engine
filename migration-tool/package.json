		"@com.mgmtp.a12.utils/utils-localization": "catalog:a12Libs",
		"@types/node": "catalog:devLibs",
		"@types/semver": "^7.7.1",
		"@vitest/coverage-v8": "catalog:devLibs",
		"semver": "^7.7.3",
		"vite": "catalog:devLibs",
		"vitest": "catalog:devLibs"
	},
	"bin": {
		"relationship-ui-model-migration": "bin/relationship-ui-model-migration"
	},
	"files": [
		"bin",
		"lib",
		"src",
		"cyclonedx.json",
