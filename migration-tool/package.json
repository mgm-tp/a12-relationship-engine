{
	"name": "@com.mgmtp.a12.relationshipengine/relationshipengine-model-migration",
	"version": "3.0.0",
	"type": "module",
	"description": "Relationship UI Model (RuM) Migration Tool",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"scripts": {
		"test": "pnpm \"/test:/\"",
		"skip:consistency": "migration-tool-utils validate-consistency",
		"test:unit": "vitest run",
		"update": "pnpm test:unit --update",
		"generate-step": "migration-tool-utils generate-step",
		"generate-schema": "migration-tool-utils compile",
		"migrate": "./bin/relationship-ui-model-migration .."
	},
	"dependencies": {
		"@com.mgmtp.a12.migrationtool/migrationtool-core": "catalog:a12Libs"
	},
	"devDependencies": {
		"@com.mgmtp.a12.base/base-model-api": "catalog:a12Libs",
		"@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12Libs",
